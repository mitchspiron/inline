---
import type { Page, RichtextField, TextField } from '../content/schema';
import { styleClasses } from '../lib/style-tokens';

interface Props {
  /** Données de la page (page.data). Inutile si `field` est fourni. */
  data?: Page;
  /** Chemin de la clé dans le JSON, ex. « blocks.hero.title ». */
  path: string;
  /**
   * Champ déjà résolu. Sert aux items de collection, dont le chemin contient
   * un identifiant : c'est la boucle qui le connaît, pas ce composant.
   */
  field?: TextField | RichtextField;
  /** Balise de rendu. */
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}

const { data, path, field: given, as: Tag = 'p', class: extraClass = '' } = Astro.props;

/**
 * Résout le chemin dans le JSON. Un `data-cms` qui pointe vers une clé absente
 * fait échouer le build — contrôle volontaire, ne pas l'assouplir (CLAUDE.md).
 */
function resolveField(source: unknown, keyPath: string): TextField | RichtextField {
  const node = keyPath
    .split('.')
    .reduce<any>((acc, key) => (acc == null ? undefined : acc[key]), source);

  if (node == null) {
    throw new Error(`[Editable] Le chemin « ${keyPath} » n'existe pas dans le contenu.`);
  }
  if (node.type !== 'text' && node.type !== 'richtext') {
    throw new Error(
      `[Editable] Le chemin « ${keyPath} » est de type « ${node.type} ». ` +
        'Ce composant ne rend que du texte ; les médias ont le leur.',
    );
  }
  return node as TextField | RichtextField;
}

if (!given && !data) {
  throw new Error(`[Editable] « ${path} » : il faut fournir « data » ou « field ».`);
}
const field = given ?? resolveField(data, path);

// Le richtext n'a pas d'objet `style` : sa mise en forme est dans son balisage.
const classes = [
  ...(field.type === 'text' ? styleClasses(field.style) : []),
  extraClass,
]
  .filter(Boolean)
  .join(' ');
---

{/* Rendu statique pur : aucune directive client:*, la valeur est dans le HTML brut. */}
{
  field.type === 'richtext' ? (
    <Tag data-cms={path} data-cms-type="richtext" class={classes} set:html={field.value} />
  ) : (
    <Tag data-cms={path} data-cms-type="text" class={classes}>
      {field.value}
    </Tag>
  )
}
