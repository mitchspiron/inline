---
import '../styles/tokens.css';
import { site } from '../content/site';

interface Props {
  title: string;
  description: string;
  /** Fichier de contenu source — point d'ancrage de l'overlay, inerte sinon. */
  contentFile: string;
  locale: string;
  pageName: string;
}

const { title, description, contentFile, locale, pageName } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/**
 * En développement, l'overlay est servi par Vite depuis les sources ;
 * en production, c'est le paquet compilé par esbuild.
 */
const overlaySrc = import.meta.env.DEV ? '/src/editor/index.ts' : '/editor/overlay.js';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body data-cms-file={contentFile} data-cms-locale={locale} data-cms-page={pageName}>
    <nav class="site-nav">
      {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <slot />

    <footer class="site-footer">
      <p>{site.contact.email}{site.contact.phone ? ` — ${site.contact.phone}` : ''}</p>
      {site.contact.address && <p>{site.contact.address}</p>}
      <p>{site.footer.legal}</p>
    </footer>

    {/*
      Amorce d'édition. Un visiteur ordinaire n'exécute qu'une lecture de cookie
      et ne télécharge rien : le contenu de la page ne dépend d'aucun JavaScript.
      Le témoin ne porte aucun secret et ne donne aucun droit — toutes les
      écritures restent soumises au cookie de session, vérifié côté serveur.
    */}
    <script
      is:inline
      set:html={`document.cookie.includes("inline_edit=1")&&document.head.appendChild(Object.assign(document.createElement("script"),{type:"module",src:"${overlaySrc}"}))`}
    />
  </body>
</html>
