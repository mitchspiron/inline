---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Editable from '../components/Editable.astro';
import Media from '../components/Media.astro';
import Collection from '../components/Collection.astro';
import Testimonial from '../components/Testimonial.astro';

// Lot 0 : une page, une langue. Le routage [lang]/[...slug] viendra avec le multilingue.
const LOCALE = 'fr';
const PAGE = 'home';

const page = await getEntry('pages', `${LOCALE}/${PAGE}`);
if (!page) {
  throw new Error(`Contenu introuvable : src/content/pages/${LOCALE}/${PAGE}.json`);
}
const data = page.data;
---

<Base
  title={data.meta.title}
  description={data.meta.description}
  contentFile={`src/content/pages/${LOCALE}/${PAGE}.json`}
  locale={LOCALE}
  pageName={PAGE}
>
  <main class="page">
    <section class="hero">
      <Editable data={data} path="blocks.hero.title" as="h1" />
      <Editable data={data} path="blocks.hero.subtitle" as="p" />
      <Editable data={data} path="blocks.hero.cta" as="p" />
    </section>

    <section>
      <Editable data={data} path="blocks.pitch.body" as="p" />
      <Editable data={data} path="blocks.pitch.detail" as="p" />
    </section>

    <section class="testimonials">
      <Collection
        data={data}
        name="testimonials"
        item={Testimonial}
        blank={{
          quote: {
            type: 'text',
            value: 'Leur retour, en une phrase.',
            style: { size: 'lg', weight: 'regular', italic: true, align: 'left', color: 'primary' },
          },
          author: {
            type: 'text',
            value: 'Prénom N., fonction',
            style: { size: 'sm', weight: 'medium', italic: false, align: 'left', color: 'muted' },
          },
        }}
      />
    </section>

    <section class="showcase">
      <Media
        data={data}
        path="blocks.showcase.visual"
        widths={[480, 800, 1200, 1600]}
        sizes="(max-width: 48rem) 100vw, 48rem"
      />
      <Media data={data} path="blocks.showcase.film" />
    </section>
  </main>
</Base>
