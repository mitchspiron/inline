---
import '../styles/tokens.css';
import { site } from '../content/site';

// Une seule chose à faire sur cette page : entrer. Pas de tableau de bord,
// pas de liste de pages, pas de vocabulaire technique.
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Modifier le site</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <main class="admin">
      <h1>Modifier votre site</h1>
      <p class="admin-intro">
        Entrez la clé qui vous a été transmise. Vous arriverez ensuite sur votre site,
        où vous pourrez modifier les textes directement sur la page.
      </p>

      <form class="admin-form" id="form">
        <label for="key">Clé du site</label>
        <input
          id="key"
          name="key"
          type="password"
          autocomplete="current-password"
          required
          autofocus
        />
        <button type="submit" id="submit">Entrer</button>
        <p class="admin-error" id="error" role="alert" hidden></p>
      </form>

      <p class="admin-help">
        Clé perdue ou plus valable ? Contactez-nous à
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
      </p>
    </main>

    <style>
      .admin {
        max-width: 26rem;
        margin: 0 auto;
        padding: var(--space-8) var(--space-3);
      }
      .admin h1 {
        font-size: var(--size-xl);
        margin: 0 0 var(--space-2);
      }
      .admin-intro {
        color: var(--color-muted);
        margin: 0 0 var(--space-4);
      }
      .admin-form {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
      }
      .admin-form label {
        font-weight: var(--weight-semibold);
        font-size: var(--size-sm);
      }
      .admin-form input {
        font: inherit;
        padding: 0.6rem 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
      }
      .admin-form input:focus {
        outline: 2px solid var(--color-accent);
        outline-offset: 1px;
      }
      .admin-form button {
        margin-top: var(--space-1);
        font: inherit;
        font-weight: var(--weight-semibold);
        padding: 0.6rem 1rem;
        border: 0;
        border-radius: 8px;
        background: var(--color-accent);
        color: var(--color-inverse);
        cursor: pointer;
      }
      .admin-form button:disabled {
        opacity: 0.5;
        cursor: default;
      }
      .admin-error {
        margin: var(--space-1) 0 0;
        color: #b42318;
        font-size: var(--size-sm);
      }
      .admin-help {
        margin-top: var(--space-4);
        color: var(--color-muted);
        font-size: var(--size-sm);
      }
    </style>

    <script>
      const form = document.getElementById('form') as HTMLFormElement;
      const field = document.getElementById('key') as HTMLInputElement;
      const submit = document.getElementById('submit') as HTMLButtonElement;
      const error = document.getElementById('error') as HTMLParagraphElement;

      function show(message: string): void {
        error.textContent = message;
        error.hidden = false;
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        error.hidden = true;
        submit.disabled = true;
        submit.textContent = 'Vérification…';

        try {
          // La clé part au serveur et n'est comparée que là. Rien n'est conservé
          // dans le navigateur : ni la clé, ni son empreinte.
          const response = await fetch('/api/auth', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ key: field.value }),
          });

          if (response.ok) {
            window.location.href = '/' + document.documentElement.lang + '/';
            return;
          }

          const body = (await response.json().catch(() => ({}))) as { error?: string };
          show(
            response.status === 429
              ? (body.error ?? 'Trop de tentatives. Réessayez dans un quart d\'heure.')
              : 'Clé incorrecte.',
          );
        } catch (cause) {
          console.warn('[admin] appel impossible', cause);
          show('La vérification n\'a pas pu aboutir, réessayez.');
        }

        field.value = '';
        field.focus();
        submit.disabled = false;
        submit.textContent = 'Entrer';
      });
    </script>
  </body>
</html>
