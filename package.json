{
  "name": "inline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run bundle:editor",
    "bundle:editor": "esbuild src/editor/index.ts --bundle --minify --format=esm --target=es2020 --splitting --outdir=dist/editor --entry-names=overlay --chunk-names=[name]-[hash]",
    "preview": "astro preview",
    "check": "node scripts/check-html.mjs && node scripts/check-secrets.mjs",
    "test": "npm run test:git && npm run test:auth && npm run test:sanitize && npm run test:media && npm run test:heic && npm run build && npm run test:editor",
    "test:git": "node scripts/test-git-provider.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:editor": "node scripts/test-editor.mjs",
    "serve:functions": "wrangler pages dev",
    "mock:git": "node scripts/mock-git-api.mjs",
    "make:key": "node scripts/make-key.mjs",
    "test:sanitize": "node scripts/test-sanitize.mjs",
    "test:media": "node scripts/test-media.mjs",
    "test:heic": "node scripts/test-heic.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "astro": "^5.2.5",
    "dompurify": "^3.4.13",
    "htmlparser2": "^12.0.0",
    "libheif-js": "^1.19.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "wrangler": "^3.107.2"
  },
  "description": "Edition de contenu en front pour sites statiques."
}
