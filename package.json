{
  "name": "inline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "node scripts/check-html.mjs && node scripts/check-locales.mjs && node scripts/check-logs.mjs && node scripts/check-secrets.mjs",
    "test": "npm run test:git && npm run test:auth && npm run test:guard && npm run test:bootstrap && node scripts/test-scaffold.mjs --court && npm run test:sanitize && npm run test:media && npm run test:heic && npm run build && npm run test:locales && npm run test:editor",
    "test:git": "node scripts/test-git-provider.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:guard": "node scripts/test-guard.mjs",
    "test:bootstrap": "node scripts/test-bootstrap.mjs",
    "test:scaffold": "node scripts/test-scaffold.mjs",
    "test:pack": "node scripts/test-scaffold.mjs --paquet",
    "test:editor": "node scripts/test-editor.mjs",
    "serve:functions": "wrangler pages dev",
    "mock:git": "node scripts/mock-git-api.mjs",
    "make:key": "node scripts/make-key.mjs",
    "create:site": "node scripts/create-site.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "test:sanitize": "node scripts/test-sanitize.mjs",
    "test:media": "node scripts/test-media.mjs",
    "test:heic": "node scripts/test-heic.mjs",
    "test:locales": "node scripts/test-locales.mjs"
  },
  "dependencies": {
    "astro": "^5.2.5",
    "inline-core": "^2.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "wrangler": "^3.107.2"
  },
  "description": "Edition de contenu en front pour sites statiques."
}
