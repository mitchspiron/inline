---
import 'inline-core/styles/tokens.css';
import '../styles/theme.css';
import { site } from '../content/site';
import { DEFAULT_LOCALE, LOCALE_LABELS, localePath } from '../lib/locales';

interface Props {
  title: string;
  description: string;
  /** Fichier de contenu source — point d'ancrage de l'overlay, inerte sinon. */
  contentFile: string;
  locale: string;
  pageName: string;
  /** Adresses de la même page dans les autres langues. */
  alternates?: Array<{ locale: string; href: string }>;
  /** Nombre de champs repris de la langue par défaut. */
  untranslated?: number;
}

const {
  title,
  description,
  contentFile,
  locale,
  pageName,
  alternates = [],
  untranslated = 0,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/**
 * Liens réciproques entre langues, plus `x-default`.
 *
 * Chaque page se déclare elle-même en plus de ses traductions : c'est la
 * réciprocité qu'attendent les moteurs, une page qui ne se cite pas est
 * ignorée du groupe.
 */
const hreflangs = alternates.map((entry) => ({
  hreflang: entry.locale,
  href: new URL(entry.href, Astro.site).href,
}));
const defaultAlternate = alternates.find((entry) => entry.locale === DEFAULT_LOCALE);

---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {hreflangs.map((entry) => <link rel="alternate" hreflang={entry.hreflang} href={entry.href} />)}
    {
      defaultAlternate && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(defaultAlternate.href, Astro.site).href}
        />
      )
    }
  </head>
  <body
    data-cms-file={contentFile}
    data-cms-locale={locale}
    data-cms-page={pageName}
    data-cms-untranslated={untranslated > 0 ? String(untranslated) : undefined}
    data-cms-locales={JSON.stringify(
      alternates.map((entry) => ({
        locale: entry.locale,
        href: entry.href,
        label: LOCALE_LABELS[entry.locale as keyof typeof LOCALE_LABELS] ?? entry.locale,
      })),
    )}
  >
    <nav class="site-langs" aria-label="Langues">
      {
        alternates.map((entry) => (
          <a
            href={entry.href}
            hreflang={entry.locale}
            lang={entry.locale}
            aria-current={entry.locale === locale ? 'true' : undefined}
          >
            {LOCALE_LABELS[entry.locale as keyof typeof LOCALE_LABELS] ?? entry.locale}
          </a>
        ))
      }
    </nav>

    <nav class="site-nav">
      {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <slot />

    <footer class="site-footer">
      <p>{site.contact.email}{site.contact.phone ? ` — ${site.contact.phone}` : ''}</p>
      {site.contact.address && <p>{site.contact.address}</p>}
      <p>{site.footer.legal}</p>
    </footer>

    {/* L'amorce d'édition est posée par l'intégration : rien à faire ici. */}
  </body>
</html>
