---
import { Image } from 'astro:assets';
import type { ImageField, Page, VideoField } from 'inline-core/schema';
import { embedUrl } from 'inline-core/video';

interface Props {
  data: Page;
  path: string;
  class?: string;
  /** Largeurs proposées au navigateur. Structure : développeur. */
  widths?: number[];
  sizes?: string;
  untranslated?: Set<string>;
}

const { data, path, class: extraClass = '', widths, sizes, untranslated } = Astro.props;
const pending = untranslated?.has(path) ? 'true' : undefined;

function resolveField(source: unknown, keyPath: string): ImageField | VideoField {
  const node = keyPath
    .split('.')
    .reduce<any>((acc, key) => (acc == null ? undefined : acc[key]), source);

  if (node == null) {
    throw new Error(`[Media] Le chemin « ${keyPath} » n'existe pas dans le contenu.`);
  }
  if (node.type !== 'media') {
    throw new Error(`[Media] Le chemin « ${keyPath} » est de type « ${node.type} », pas un média.`);
  }
  return node as ImageField | VideoField;
}

/**
 * Les fichiers vivent dans `src/media` du site et non dans `public/media` :
 * c'est la seule façon pour `<Image />` de les traiter au build — AVIF, WebP,
 * jeu de largeurs, dimensions calculées. Un fichier de `public/` serait servi
 * tel quel, sans aucune de ces garanties.
 *
 * Ce composant vit dans le paquet, les images vivent dans le site : la
 * recherche des fichiers doit donc s'exécuter là-bas. `inline:media` est
 * résolu par l'intégration vers `src/media/library.ts` du site, qu'elle crée
 * s'il manque.
 */
import { library } from 'inline:media';

function resolveImage(src: string): ImageMetadata {
  const name = src.replace(/^\/+/, '').replace(/^src\/media\//, '');
  const entry = library[`./${name}`];
  if (!entry) {
    throw new Error(
      `[Media] Le fichier « ${src} » est absent de src/media. ` +
        `Fichiers disponibles : ${Object.keys(library).join(', ') || 'aucun'}`,
    );
  }
  return entry.default;
}

const field = resolveField(data, path);
---

{
  field.kind === 'image' ? (
    <Image
      src={resolveImage(field.src)}
      alt={field.alt}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      class={extraClass}
      data-cms={path}
      data-cms-type="media"
      data-cms-kind="image"
      data-cms-untranslated={pending}
    />
  ) : (
    /*
      Le contenu de l'iframe est chez le fournisseur ; le titre, lui, est dans
      le HTML servi. `loading="lazy"` ne retire rien de l'index : ce n'est pas
      une hydratation de composant, l'élément est là dès la source.
    */
    <figure
      class={extraClass}
      data-cms={path}
      data-cms-type="media"
      data-cms-kind="video"
      data-cms-untranslated={pending}
      data-cms-provider={field.provider}
      data-cms-video-id={field.videoId}
    >
      <iframe
        src={embedUrl(field.provider, field.videoId)}
        title={field.title}
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        width="560"
        height="315"
      />
      <figcaption>{field.title}</figcaption>
    </figure>
  )
}
